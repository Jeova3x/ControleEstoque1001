{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "env": {
    "GITHUB_OWNER": "@github_owner",
    "GITHUB_REPO": "@github_repo",
    "GITHUB_TOKEN": "@github_token"
  }
}
